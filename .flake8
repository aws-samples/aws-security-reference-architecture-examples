[flake8]
# Ruff (pyproject.toml [tool.ruff]) is the primary linter. flake8 runs only:
#   - pycodestyle (E, W): ruff implements its whitespace rules in preview only
#   - dlint (DUO), flake8-expression-complexity (ECE),
#     flake8-annotations-complexity (TAE), flake8-functions (CFQ):
#     maintained plugins with no ruff equivalent
# Cognitive complexity is checked by complexipy.
max-line-length = 150
max-parameters-amount = 8
exclude =
    .git,
    __pycache__,
    .vscode

select = E,W,DUO,ECE,TAE,CFQ

# disable below checks (flake8 >= 6 does not allow inline comments in option values):
#   W292: no newline at end of file
#   W503: Line break occurred before binary operator
#   E203: whitespace before ':'
#   E226: missing whitespace around arithmetic operator
#   E231: missing whitespace after ':' (false positives with ARN formats)
#   E702: multiple statements on one line (semicolon)
#   E713: test for membership should be 'not in' (style preference)
#   CFQ004: function has too many returns
ignore =
    W292,
    W503,
    E203,
    E226,
    E231,
    E702,
    E713,
    CFQ004
