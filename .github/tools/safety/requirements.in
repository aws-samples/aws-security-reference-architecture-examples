# Vulnerability scanner used by .github/workflows/safety.yml.
#
# Installed in its own virtualenv on the CI runner, not in the project
# environment, so the scanner's dependencies (e.g. filelock<4 via safety 3.x)
# are not project dependencies in poetry.lock.
#
# requirements.txt is generated from this file, fully pinned with hashes:
#   pip-compile --generate-hashes --allow-unsafe --strip-extras --no-emit-index-url \
#     --output-file=.github/tools/safety/requirements.txt .github/tools/safety/requirements.in
# Dependabot keeps both files current (see .github/dependabot.yml).
safety==3.8.1
